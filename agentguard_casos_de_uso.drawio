        <!-- ================= USE CASES ================= -->
        <!-- UC01: Gestionar Organización y Usuarios -->
        <mxCell id="uc_01" value="&lt;b&gt;UC01: Gestionar Organización y Usuarios&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#64748b;&#39;&gt;(Alta de Tenant, invitación y asignación de roles)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4338ca;strokeWidth=2;fontColor=#1e293b;fontSize=12;shadow=1;" vertex="1" parent="1">
