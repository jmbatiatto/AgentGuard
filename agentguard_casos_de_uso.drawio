          <mxGeometry x="320" y="1100" width="310" height="75" as="geometry" />
        </mxCell>

        <!-- UC05: Interceptar Solicitud en Runtime (CORE ENGINE) -->
        <mxCell id="uc_05" value="&lt;b style=&#39;font-size:13px;&#39;&gt;UC05: Solicitar Ejecución de Acción en Runtime&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#64748b;&#39;&gt;(Invocación interceptada por AgentGuard Gateway)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=3;fontColor=#0369a1;fontSize=12;shadow=1;" vertex="1" parent="1">
