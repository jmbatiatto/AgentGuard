        <mxCell id="uc_title" value="&lt;font color=&#39;#ffffff&#39; face=&#39;Helvetica&#39;&gt;&lt;b style=&#39;font-size:26px;&#39;&gt;🎯 AgentGuard — Diagrama de Casos de Uso del Sistema (UML Estándar)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:14px;color:#94a3b8;&#39;&gt;Mapeo Integral de Actores Humanos y No Humanos, Límites del Sistema, Relaciones de Inclusión (&amp;lt;&amp;lt;include&amp;gt;&amp;gt;) y Extensión (&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;)&lt;/span&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
