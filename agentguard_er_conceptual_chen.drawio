        <mxCell id="dict_legend" value="&lt;div style=&#39;font-size:12px;color:#1e293b;&#39;&gt;&lt;b&gt;🎓 Fundamento Metodológico para Cátedras de Ingeniería de Software / Base de Datos:&lt;/b&gt;&lt;br&gt;&lt;p style=&#39;margin-top:6px;line-height:1.5;&#39;&gt;El Modelo Conceptual de Chen prioriza la &lt;b&gt;claridad semántica&lt;/b&gt; de las relaciones y la asignación de cardinalidades mínimas y máximas sin ensuciar el grafo con listas interminables de columnas. La &lt;b&gt;Biblioteca de Atributos&lt;/b&gt; desacoplada actúa como el Diccionario de Datos canónico exigido por metodologías estructuradas (Yourdon / Pressman), permitiendo auditar la tipificación de dominios, la nulabilidad y los roles de claves sin perder la visión panorámica de la arquitectura.&lt;/p&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;align=left;verticalAlign=top;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="1580" y="1232.5" width="780" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
