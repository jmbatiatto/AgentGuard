        <mxCell id="dict_box_2" value="&lt;table border=&#39;1&#39; cellpadding=&#39;4&#39; cellspacing=&#39;0&#39; style=&#39;border-collapse:collapse;width:100%;font-size:11px;&#39;&gt; &lt;tr style=&#39;background-color:#1e3a8a;color:#ffffff;&#39;&gt;&lt;th colspan=&#39;5&#39; align=&#39;left&#39;&gt;👤 2. Entidad: USUARIO (User)&lt;/th&gt;&lt;/tr&gt; &lt;tr style=&#39;background-color:#f1f5f9;&#39;&gt;&lt;th&gt;Atributo&lt;/th&gt;&lt;th&gt;Rol&lt;/th&gt;&lt;th&gt;Tipo de Dominio&lt;/th&gt;&lt;th&gt;Nulo&lt;/th&gt;&lt;th&gt;Descripción Funcional&lt;/th&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PK&lt;/td&gt;&lt;td&gt;UUID v4&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Identificador del usuario del sistema.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;organization_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;FK&lt;/td&gt;&lt;td&gt;UUID v4&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Tenant al cual pertenece el usuario.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;email&lt;/b&gt;&lt;/td&gt;&lt;td&gt;C. Cand.&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Correo electrónico único para autenticación.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;role&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Simple&lt;/td&gt;&lt;td&gt;ENUM&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Valores: ADMIN, OPERATOR, APPROVER.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;created_at&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Simple&lt;/td&gt;&lt;td&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Fecha y hora de alta del usuario.&lt;/td&gt;&lt;/tr&gt; &lt;/table&gt;" style="text;html=1;strokeColor=#cbd5e1;fillColor=#ffffff;rounded=1;shadow=1;overflow=hidden;" parent="1" vertex="1">
