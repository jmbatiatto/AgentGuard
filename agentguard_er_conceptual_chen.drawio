        <mxCell id="dict_box_4" value="&lt;table border=&#39;1&#39; cellpadding=&#39;4&#39; cellspacing=&#39;0&#39; style=&#39;border-collapse:collapse;width:100%;font-size:11px;&#39;&gt; &lt;tr style=&#39;background-color:#075985;color:#ffffff;&#39;&gt;&lt;th colspan=&#39;5&#39; align=&#39;left&#39;&gt;🛠️ 4. Entidades: HERRAMIENTA y ACCIÓN_TOOL&lt;/th&gt;&lt;/tr&gt; &lt;tr style=&#39;background-color:#f1f5f9;&#39;&gt;&lt;th&gt;Atributo&lt;/th&gt;&lt;th&gt;Rol&lt;/th&gt;&lt;th&gt;Tipo de Dominio&lt;/th&gt;&lt;th&gt;Nulo&lt;/th&gt;&lt;th&gt;Descripción Funcional&lt;/th&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;Tool.id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PK&lt;/td&gt;&lt;td&gt;UUID v4&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Identificador de la herramienta o API REST protegida.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;Tool.protocol&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Simple&lt;/td&gt;&lt;td&gt;VARCHAR(20)&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Protocolo de invocación: REST.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;Tool.endpoint_url&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Simple&lt;/td&gt;&lt;td&gt;VARCHAR(512)&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;URL protegida de destino.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;ToolAction.id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PK&lt;/td&gt;&lt;td&gt;UUID v4&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Identificador único de la acción concreta.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;ToolAction.tool_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;FK&lt;/td&gt;&lt;td&gt;UUID v4&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Herramienta padre que la expone.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;ToolAction.action_name&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Simple&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Nombre del método (ej. create_quote, refund).&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;ToolAction.risk_level&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Simple&lt;/td&gt;&lt;td&gt;ENUM&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Nivel de criticidad: LOW, MEDIUM, HIGH, CRITICAL.&lt;/td&gt;&lt;/tr&gt; &lt;/table&gt;" style="text;html=1;strokeColor=#cbd5e1;fillColor=#ffffff;rounded=1;shadow=1;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry x="810" y="990" width="740" height="220" as="geometry" />
        </mxCell>
        <mxCell id="dict_box_5" value="&lt;table border=&#39;1&#39; cellpadding=&#39;4&#39; cellspacing=&#39;0&#39; style=&#39;border-collapse:collapse;width:100%;font-size:11px;&#39;&gt; &lt;tr style=&#39;background-color:#991b1b;color:#ffffff;&#39;&gt;&lt;th colspan=&#39;5&#39; align=&#39;left&#39;&gt;📋 5. Entidades: POLÍTICA y REGLA_POLÍTICA&lt;/th&gt;&lt;/tr&gt; &lt;tr style=&#39;background-color:#f1f5f9;&#39;&gt;&lt;th&gt;Atributo&lt;/th&gt;&lt;th&gt;Rol&lt;/th&gt;&lt;th&gt;Tipo de Dominio&lt;/th&gt;&lt;th&gt;Nulo&lt;/th&gt;&lt;th&gt;Descripción Funcional&lt;/th&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;Policy.priority&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Simple&lt;/td&gt;&lt;td&gt;INTEGER&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Orden de resolución en caso de solapamiento.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;PolicyRule.effect&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Simple&lt;/td&gt;&lt;td&gt;ENUM&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Resultado: ALLOW, DENY, REQUIRE_APPROVAL.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;PolicyRule.tool_action_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;FK&lt;/td&gt;&lt;td&gt;UUID v4&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Acción objeto de la regla de seguridad.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;PolicyRule.target_agent_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;FK&lt;/td&gt;&lt;td&gt;UUID v4&lt;/td&gt;&lt;td&gt;Sí&lt;/td&gt;&lt;td&gt;Si es nulo, aplica globalmente a todo agente.&lt;/td&gt;&lt;/tr&gt; &lt;tr&gt;&lt;td&gt;&lt;b&gt;PolicyRule.conditions&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Compuesto&lt;/td&gt;&lt;td&gt;JSONB&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Predicados lógicos (umbrales, horarios, IP, roles).&lt;/td&gt;&lt;/tr&gt; &lt;/table&gt;" style="text;html=1;strokeColor=#cbd5e1;fillColor=#ffffff;rounded=1;shadow=1;overflow=hidden;" parent="1" vertex="1">
