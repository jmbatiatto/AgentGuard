        <!-- Execution -> ToolAction (FK) -->
        <mxCell id="rel_exec_toolaction" value="acción invocada (N : 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#14b8a6;strokeWidth=2;fontColor=#1e293b;fontSize=11;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent_execution" target="ent_toolaction">
