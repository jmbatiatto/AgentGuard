        <mxCell id="ent_alert" value="&lt;div style=&#39;background-color:#991b1b;padding:8px 10px;color:#ffffff;font-weight:bold;font-size:13px;text-align:center;&#39;&gt;🚨 Alert (Incidente de Seguridad)&lt;/div&gt;&lt;div style=&#39;padding:8px 10px;font-size:11px;line-height:1.5;&#39;&gt;&lt;table style=&#39;width:100%;border-collapse:collapse;&#39;&gt;&lt;tr style=&#39;background-color:#fee2e2;&#39;&gt;&lt;td style=&#39;width:25px;&#39;&gt;&lt;b style=&#39;color:#991b1b;&#39;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style=&#39;color:#dc2626;&#39;&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;organization_id&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style=&#39;color:#dc2626;&#39;&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;execution_id&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID (Null)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;alert_type&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;VARCHAR(100)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;severity&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;ENUM(LOW,...)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;status&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;ENUM(OPEN,...)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style=&#39;color:#dc2626;&#39;&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;resolved_by_user_id&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID (Null)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;resolved_at&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#991b1b;strokeWidth=2;shadow=1;overflow=hidden;verticalAlign=top;align=left;" parent="1" vertex="1">
          <mxGeometry x="1960" y="950" width="340" height="240" as="geometry" />
        </mxCell>
        <mxCell id="ent_auditevent" value="&lt;div style=&#39;background-color:#047857;padding:8px 10px;color:#ffffff;font-weight:bold;font-size:13px;text-align:center;&#39;&gt;📜 AuditEvent (Trazabilidad Inmutable)&lt;/div&gt;&lt;div style=&#39;padding:8px 10px;font-size:11px;line-height:1.5;&#39;&gt;&lt;table style=&#39;width:100%;border-collapse:collapse;&#39;&gt;&lt;tr style=&#39;background-color:#d1fae5;&#39;&gt;&lt;td style=&#39;width:25px;&#39;&gt;&lt;b style=&#39;color:#047857;&#39;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style=&#39;color:#059669;&#39;&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;organization_id&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;actor_type&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;ENUM(USER,...)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;actor_id&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;event_type&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;VARCHAR(100)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;metadata&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;JSONB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;timestamp&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#047857;strokeWidth=2;shadow=1;overflow=hidden;verticalAlign=top;align=left;" parent="1" vertex="1">
          <mxGeometry x="1330" y="1140" width="380" height="190" as="geometry" />
