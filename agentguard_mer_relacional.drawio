        <!-- Execution -> Approval (1 : 0..1) -->
        <mxCell id="rel_exec_approval" value="requiere (1 : 0..1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;fontColor=#1e293b;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent_execution" target="ent_approval">
