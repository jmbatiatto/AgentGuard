        <!-- ================= ENTITY 10: APPROVAL ================= -->
        <mxCell id="ent_approval" value="&lt;table border=&#39;0&#39; cellpadding=&#39;4&#39; cellspacing=&#39;0&#39; style=&#39;width:100%;border-collapse:collapse;&#39;&gt;&lt;tr style=&#39;background-color:#be123c;&#39;&gt;&lt;td colspan=&#39;3&#39; align=&#39;center&#39; style=&#39;color:#ffffff;font-weight:bold;&#39;&gt;✋ Approval (Aprobación Humana)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background-color:#ffe4e6;&#39;&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;execution_id&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;assigned_approver_id&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;UUID (Nullable)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;status&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;ENUM(PENDING,APPROVED,REJECTED,EXPIRED)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;resolution_reason&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;resolved_at&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;TIMESTAMPTZ (Nullable)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;fontColor=#1e293b;strokeColor=#f43f5e;strokeWidth=2;fillColor=#ffffff;rounded=1;shadow=1;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="1740" y="580" width="340" height="160" as="geometry" />
        </mxCell>

        <!-- ================= ENTITY 11: ALERT ================= -->
        <mxCell id="ent_alert" value="&lt;table border=&#39;0&#39; cellpadding=&#39;4&#39; cellspacing=&#39;0&#39; style=&#39;width:100%;border-collapse:collapse;&#39;&gt;&lt;tr style=&#39;background-color:#b91c1c;&#39;&gt;&lt;td colspan=&#39;3&#39; align=&#39;center&#39; style=&#39;color:#ffffff;font-weight:bold;&#39;&gt;🚨 Alert (Incidente de Seguridad)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background-color:#fee2e2;&#39;&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;organization_id&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;execution_id&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;UUID (Nullable)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;alert_type&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;VARCHAR(100)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;severity&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;ENUM(LOW,MEDIUM,HIGH,CRITICAL)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;status&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;ENUM(OPEN,INVESTIGATING,RESOLVED,DISMISSED)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;resolved_by_user_id&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;UUID (Nullable)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;resolved_at&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;TIMESTAMPTZ (Nullable)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;fontColor=#1e293b;strokeColor=#dc2626;strokeWidth=2;fillColor=#ffffff;rounded=1;shadow=1;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="1740" y="780" width="340" height="210" as="geometry" />
        </mxCell>

        <!-- ================= ENTITY 12: AUDIT EVENT ================= -->
        <mxCell id="ent_auditevent" value="&lt;table border=&#39;0&#39; cellpadding=&#39;4&#39; cellspacing=&#39;0&#39; style=&#39;width:100%;border-collapse:collapse;&#39;&gt;&lt;tr style=&#39;background-color:#047857;&#39;&gt;&lt;td colspan=&#39;3&#39; align=&#39;center&#39; style=&#39;color:#ffffff;font-weight:bold;&#39;&gt;📜 AuditEvent (Trazabilidad Inmutable)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background-color:#d1fae5;&#39;&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;organization_id&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;actor_type&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;ENUM(USER,AGENT,SYSTEM)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;actor_id&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;event_type&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;VARCHAR(100)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;metadata&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;JSONB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;timestamp&lt;/td&gt;&lt;td align=&#39;right&#39;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;fontColor=#1e293b;strokeColor=#10b981;strokeWidth=2;fillColor=#ffffff;rounded=1;shadow=1;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="1270" y="930" width="370" height="170" as="geometry" />
        </mxCell>

        <!-- ================= RESUMEN DE CORRECCIONES PANEL ================= -->
        <mxCell id="box_notes" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="810" width="1070" height="290" as="geometry" />
        </mxCell>
        <mxCell id="txt_notes_title" value="&lt;b style=&#39;font-size:16px;color:#0f172a;&#39;&gt;📌 Resumen de Correcciones y Decisiones de Modelado v2.0&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="820" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="txt_notes_content" value="&lt;ol style=&#39;font-size:12px;color:#334155;margin:0;padding-left:20px;&#39;&gt;&lt;li&gt;&lt;b&gt;Desacoplamiento Agente &amp;harr; Herramientas (N:N):&lt;/b&gt; Se incorpora la tabla asociativa &lt;code&gt;AgentTool&lt;/code&gt; para modelar qué herramientas tiene permitidas cada agente con su configuración particular (&lt;code&gt;config JSONB&lt;/code&gt;).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Granularidad de Acción (&lt;code&gt;ToolAction&lt;/code&gt;):&lt;/b&gt; Se eliminó el campo genérico &lt;code&gt;action&lt;/code&gt; (string) de las reglas. Ahora &lt;code&gt;PolicyRule&lt;/code&gt; y &lt;code&gt;Execution&lt;/code&gt; referencian directamente la clave foránea &lt;code&gt;tool_action_id&lt;/code&gt;, garantizando consistencia referencial y asignación de nivel de riesgo (&lt;code&gt;risk_level&lt;/code&gt;).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Manejo de Prioridades y Precedencia:&lt;/b&gt; Tanto &lt;code&gt;Policy&lt;/code&gt; como &lt;code&gt;PolicyRule&lt;/code&gt; cuentan con &lt;code&gt;priority&lt;/code&gt; entero para resolver colisiones. Por convención segura (&lt;i&gt;fail-close&lt;/i&gt;), ante empate &lt;code&gt;DENY&lt;/code&gt; tiene precedencia estricta sobre &lt;code&gt;ALLOW&lt;/code&gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Contexto de Ejecución Sanitizado:&lt;/b&gt; &lt;code&gt;request_context&lt;/code&gt; en &lt;code&gt;Execution&lt;/code&gt; almacena metadatos relevantes (horario, monto, IP, sesión) aplicando enmascaramiento estricto de secretos y credenciales para cumplimiento de privacidad.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Ciclo de Vida de Aprobaciones y Alertas:&lt;/b&gt; &lt;code&gt;Approval&lt;/code&gt; modela estados explícitos de intervención humana (&lt;code&gt;PENDING, APPROVED, REJECTED, EXPIRED&lt;/code&gt;) y &lt;code&gt;Alert&lt;/code&gt; audita quién y cuándo resolvió un incidente de seguridad.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Aislamiento Multi-Tenant Completo:&lt;/b&gt; Todas las entidades operativas portan &lt;code&gt;organization_id&lt;/code&gt; como clave foránea indexada, garantizando consultas acotadas y prevención de filtraciones entre empresas.&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="100" y="855" width="1030" height="230" as="geometry" />
        </mxCell>

