        <mxCell id="rel_tool_agenttool" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f97316;strokeWidth=2;fontColor=#1e293b;fontSize=11;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent_tool" target="ent_agenttool">
          <mxGeometry relative="1" as="geometry">
