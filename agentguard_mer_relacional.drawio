        <mxCell id="ent_approval" value="&lt;div style=&#39;background-color:#be123c;padding:8px 10px;color:#ffffff;font-weight:bold;font-size:13px;text-align:center;&#39;&gt;✋ Approval (Aprobación Humana)&lt;/div&gt;&lt;div style=&#39;padding:8px 10px;font-size:11px;line-height:1.5;&#39;&gt;&lt;table style=&#39;width:100%;border-collapse:collapse;&#39;&gt;&lt;tr style=&#39;background-color:#ffe4e6;&#39;&gt;&lt;td style=&#39;width:25px;&#39;&gt;&lt;b style=&#39;color:#be123c;&#39;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style=&#39;color:#f43f5e;&#39;&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;execution_id&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style=&#39;color:#f43f5e;&#39;&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;assigned_approver_id&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID (Null)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;status&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;ENUM(PENDING,...)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;resolution_reason&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;resolved_at&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#be123c;strokeWidth=2;shadow=1;overflow=hidden;verticalAlign=top;align=left;" parent="1" vertex="1">
