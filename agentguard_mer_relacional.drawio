decision&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;ENUM(ALLOW,...)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;status&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;ENUM(...)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style=&#39;color:#0d9488;&#39;&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;evaluated_policy_rule_id&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;UUID (Null)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;•&lt;/td&gt;&lt;td&gt;timestamp&lt;/td&gt;&lt;td style=&#39;text-align:right;color:#64748b;&#39;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;overflow=hidden;verticalAlign=top;align=left;" parent="1" vertex="1">
