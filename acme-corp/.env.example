# Variables de Entorno para ACME Corporation (Entorno Autónomo Looney Tunes)
ACME_HOST=0.0.0.0
ACME_PORT=9000
ACME_PUBLIC_URL=http://localhost:9000
ACME_DB_PATH=acme_corp.db

# Configuración de Conexión con AgentGuard y Redis
AGENTGUARD_URL=http://localhost:8000
