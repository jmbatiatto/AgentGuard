# ==============================================================================
# AgentGuard — Configuración del Cliente Demostrador CLI (agent-demo)
# ==============================================================================
# ÚNICAS VARIABLES OBLIGATORIAS:
# Los UUIDs de organización, agentes y herramientas son descubiertos automáticamente
# en runtime por el cliente CLI consultando GET /api/v1/gateway/context con la API Key.
# No es necesario copiar ni sincronizar UUIDs fijos tras un reinicio de base de datos.
# ==============================================================================

# URL base del backend AgentGuard (sin barra final)
AGENTGUARD_URL=http://localhost:8000

# API Key generada en AgentGuard (Configuración -> API Keys o al registrar una organización)
AGENTGUARD_API_KEY=ag_live_reemplazar_con_tu_api_key

# ==============================================================================
# VARIABLES OPCIONALES (Sobrescriben el descubrimiento automático si se definen):
# ==============================================================================
# ORGANIZATION_ID=
# AGENT_ID=
# DELEGATOR_USER_ID=
# TOOL_CRM_ID=
# TOOL_STRIPE_ID=
# TOOL_CATALOG_ID=
