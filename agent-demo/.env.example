# URL base del backend AgentGuard (sin barra final)
AGENTGUARD_URL=http://localhost:8000

# API Key generada en AgentGuard (Configuracion -> API Keys o al registrar una organizacion)
AGENTGUARD_API_KEY=ag_live_reemplazar_con_tu_api_key

# Identificador de la organizacion tenant (por defecto: Acme Corp de seed_demo.py)
ORGANIZATION_ID=11111111-1111-1111-1111-111111111111

# Identificador del agente de IA protegido (por defecto: Agente de Ventas de seed_demo.py)
AGENT_ID=33333333-3333-3333-3333-333333333301

# Identificador del usuario humano delegador (opcional, por defecto: operator@acmecorp.com)
DELEGATOR_USER_ID=22222222-2222-2222-2222-222222222203

# Identificadores de herramientas externas (sobrescribir si usas una organizacion nueva)
TOOL_CRM_ID=44444444-4444-4444-4444-444444444401
TOOL_STRIPE_ID=44444444-4444-4444-4444-444444444402
TOOL_CATALOG_ID=44444444-4444-4444-4444-444444444403

