# AgentGuard Frontend — Variables de Entorno de Desarrollo y Producción
# Copie este archivo a '.env' o '.env.local' para personalizar endpoints.

# URL base de la API REST de AgentGuard (Backend FastAPI)
VITE_API_URL=http://localhost:8000

# URL del canal de eventos en tiempo real WebSocket (PEP Events & SIEM Alerts)
VITE_WS_URL=ws://localhost:8000
