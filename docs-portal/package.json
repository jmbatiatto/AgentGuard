{
  "name": "agentguard-docs-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portal interactivo oficial de documentación verificada, arquitectura Zero Trust y defensa académica de AgentGuard (ITU — UNCuyo 2026)",
  "scripts": {
    "prepare-content": "node scripts/prepare-content.mjs",
    "export-diagrams": "node scripts/export-diagrams.mjs",
    "dev": "node scripts/prepare-content.mjs && vitepress dev src --port 5180",
    "build": "node scripts/prepare-content.mjs && vitepress build src",
    "preview": "vitepress preview src --port 4173"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "mermaid": "^11.4.1",
    "puppeteer-core": "^24.4.0",
    "qrcode": "^1.5.4",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4"
  }
}
