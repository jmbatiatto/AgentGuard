        <mxCell id="sm_title" value="&lt;font color=&#39;#ffffff&#39; face=&#39;Helvetica&#39;&gt;&lt;b style=&#39;font-size:26px;&#39;&gt;🔄 AgentGuard — Máquina de Estados del Ciclo de Vida en Runtime&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:14px;color:#94a3b8;&#39;&gt;Transiciones Formales de Estado para Ejecuciones (Execution), Aprobaciones Humanas (Approval) e Incidentes (Alert)&lt;/span&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
