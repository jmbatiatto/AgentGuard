# ==============================================================================
# AgentGuard Backend - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env y ajusta los valores para tu entorno local.
# ==============================================================================

# Configuración General del Proyecto
PROJECT_NAME="AgentGuard Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="agentguard-insecure-dev-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Orígenes Permitidos para CORS (Frontend React / Vite)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Conexión a Base de Datos Relacional (PostgreSQL 16)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="agentguard"
POSTGRES_PASSWORD="agentguard_secret"
POSTGRES_DB="agentguard_db"

# Conexión a Almacén en Memoria (Redis 7)
REDIS_URL="redis://localhost:6379/0"
